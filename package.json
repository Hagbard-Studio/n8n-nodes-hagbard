{
  "name": "n8n-nodes-hagbard",
  "version": "0.1.2",
  "description": "n8n nodes for Hagbard: new businesses before they open, from public records (trigger, list, get, find by name).",
  "keywords": ["n8n-community-node-package", "hagbard", "new businesses", "leads", "public records"],
  "license": "MIT",
  "homepage": "https://hagbard.studio",
  "author": { "name": "Hagbard", "email": "ben@hagbard.studio" },
  "repository": { "type": "git", "url": "git+https://github.com/Hagbard-Studio/n8n-nodes-hagbard.git" },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "files": ["dist", "!dist/tsconfig.tsbuildinfo"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/HagbardApi.credentials.js"],
    "nodes": ["dist/nodes/Hagbard/Hagbard.node.js", "dist/nodes/HagbardTrigger/HagbardTrigger.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.4",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
